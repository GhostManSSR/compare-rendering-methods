FROM node:22-alpine AS build
WORKDIR /workspace
COPY apps-react/package*.json ./apps-react/
RUN cd apps-react && npm ci
COPY apps-react ./apps-react
COPY data/products.json ./data/products.json
ARG APP_BASE=/react/
ENV APP_BASE=$APP_BASE
ENV CATALOG_FILE=/workspace/data/products.json
RUN cd apps-react && npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=5173
COPY --from=build /workspace/apps-react/package.json ./
COPY --from=build /workspace/apps-react/node_modules ./node_modules
COPY --from=build /workspace/apps-react/server.mjs ./
COPY --from=build /workspace/apps-react/dist ./dist
CMD ["node", "server.mjs"]
